    extra-libraries:  cuda, pthread
    pkgconfig-depends:   argobots, nvjitlink, sleef
    exposed-modules:  Janus.CBits
                      Janus.CBits.Argobots
                      Janus.Backend.C.CUDA.Foreign
    build-depends:    base ^>=4.20
                    , lens
    hs-source-dirs:   cbits-hs
    c-sources:        cbits/janus_abt.c
                      cbits/janus_simd.c
                      cbits/janus.c
    include-dirs:     cbits/
    default-language: Haskell2010

