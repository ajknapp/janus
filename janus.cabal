test-suite janus-test
    -- Import common warning flags.
    import:           warnings

    -- Base language which the package is written in.
    default-language: Haskell2010

    -- Modules included in this executable, other than Main.
    other-modules:    Test.Janus.Constraints
                      Test.Janus.Fix
                      Test.Janus.CSE
                      Test.Janus.CSEDefs
                      Test.Janus.Bench
                      Test.Janus.BenchDefs
                      Test.Janus.Backend.C.CUDA
                      Test.Janus.Backend.C.TH
                      Test.Janus.Backend.C.THDefs
                      Test.Janus.Backend.C.THOther
                      Test.Janus.Command.Parallel
                      Test.Janus.Control.StreamPipe
                      Test.Janus.Expression.Let
                      Test.Janus.Expression.SIMD
                      Test.Janus.Expression.SpecialMath
                      Test.Janus.SPMD
                      Test.Janus.Alloc
                      Test.Janus.Data.HKDLayout
                      Test.Janus.Data.Sequential
                      Test.Janus.Data.StackAndHeap
                      Test.Janus.Data.BitAndFilter
                      Test.Janus.Data.Hash
                      Test.Janus.Data.OrderedHashAndCache
                      Test.Janus.Data.Ordered
                      Test.Janus.Data.GraphAndSpatial
                      Test.Janus.Data.IndexedAndIntrusive
                      Test.Janus.Data.IntrusiveSchedAndIntern
                      Test.Janus.Data.SPMD
                      Test.Janus.Tensor.Core
                      Test.Janus.Tensor.Contract
                      Test.Janus.Tensor.Backends
                      Test.Janus.Tensor.Validation

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- The interface type and version of the test suite.
    type:             exitcode-stdio-1.0

    -- Directories containing source files.
    hs-source-dirs:   test

    -- The entrypoint to the test suite.
    main-is:          Main.hs
    ghc-options:      -fno-ghci-sandbox -threaded

    -- Test dependencies.
    build-depends:    base ^>=4.20
                    , async
                    , concurrency
                    , containers
                    , dejafu
                    , directory
                    , filepath
                    , hedgehog
                    , hkd
                    , janus
                    , janus-cbits
                    , lens
                    , linear
                    , mtl
                    , semilattices
                    , tasty
                    , tasty-dejafu
                    , tasty-hedgehog
                    , tasty-hunit
                    , template-haskell
                    , transformers
                    , vector
